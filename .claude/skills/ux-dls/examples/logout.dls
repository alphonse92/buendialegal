SettingsScreen: Screen {

    Title: "Hi {username}"

    PrimaryAction: "Subscription"
        -> opens SubscriptionView as bottom-sheet with slide-up

    DestructiveAction: "Close session" {
        confirm Dialog {
            title: "Log out?"
            message: "You will need to sign in again."
            confirmLabel: "Log out"
            style: destructive
        }
        result: returns to LoginScreen
    }

    States:
        Loading: shows Spinner
        Offline: shows Banner("No connection")
}

TabNavigation: BottomTabs {
    Tab: "Receipts" -> ReceiptsView
    Tab: "Dashboard" -> DashboardView
    Tab: "Settings" -> SettingsScreen
}

DashboardLayout: Layout(Column) {
    spacing: 16
    padding: 24
    scrollable: true
    $children
}

DashboardScreen: Screen {

    Variants:
        NoReceipts
        PremiumUser

    Content:
        DashboardLayout {
            DashboardCard
            TabNavigation
        }

    Variant NoReceipts {
        shows EmptyState {
            image: "empty-box"
            message: "No receipts yet"
            PrimaryAction: "Add receipt"
        }
    }
}

Flow: LogoutFlow {

    From DashboardScreen
        -> taps "Settings"

    From SettingsScreen
        -> taps "Close session"
        -> confirms

    Outcome:
        - returns to LoginScreen
}
