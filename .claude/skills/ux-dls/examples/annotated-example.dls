// ============================================
// Meal Planning — UX Specification
// Annotated example showing all DLS constructs
// ============================================

// --- Data ---
// Collections define the data structures that back UI elements.
// Fields are UX-level (what the user sees), not database columns.

Collection: MealPlans {
    Item: MealPlan {
        name
        date
        meals
        servings
    }
}

// Conditions define business rules that trigger UI behavior.
// Use aggregations like sum(), count() for computed values.

Condition: WeeklyPlanLimit {
    maxPlans = 7
    activePlans = count(MealPlans)
    exceeded when activePlans >= maxPlans
}

// --- Screens ---
// Screens are the main views. Always include:
//   - Title
//   - Content (what the user sees)
//   - Actions (what the user can do)
//   - States (loading, empty, error at minimum)

MealPlanListScreen: Screen {

    Title: "Your meal plans"

    Content:
        List of MealPlans sorted by date

    PrimaryAction: "Create plan"
        -> opens CreateMealPlanScreen as modal

    States:
        Loading: shows Spinner("Loading your plans...")
        Empty: shows EmptyState {
            image: "calendar-empty"
            message: "No meal plans yet"
            PrimaryAction: "Create your first plan"
        }
        Error: shows InlineMessage("Could not load meal plans")

    Alert when WeeklyPlanLimit.exceeded {
        style: banner
        variant: info
        message: "You've planned every day this week!"
    }
}

// Screens with user input follow the Processing pattern:
// user action -> Processing state -> Success or Error

CreateMealPlanScreen: Screen {

    Title: "New meal plan"

    Content:
        Form {
            field: "Plan name" (required)
            field: "Date" (date picker)
            field: "Servings" (stepper, default: 2)
        }

    PrimaryAction: "Save plan"

    States:
        Processing: shows Spinner("Saving your plan...")
        Error: shows InlineMessage("Could not save the plan")
        Success: returns to MealPlanListScreen

    PrimaryAction:
        -> validates form
        -> enters Processing
        -> onSuccess adds MealPlan to MealPlans
        -> returns to MealPlanListScreen
}

// --- Navigation ---

TabNavigation: MainTabs {
    Tab: "Plans" -> MealPlanListScreen
    Tab: "Recipes" -> RecipeListScreen
    Tab: "Settings" -> SettingsScreen
}

// --- Flows ---
// Flows describe end-to-end user journeys.
// Always include: entry point, steps, and outcome.

Flow: CreateMealPlanFlow {

    From MealPlanListScreen
        -> taps "Create plan"
        -> opens CreateMealPlanScreen

    In CreateMealPlanScreen
        -> fills form fields
        -> taps "Save plan"
        -> enters Processing

    When processing succeeds
        -> adds new MealPlan to MealPlans
        -> returns to MealPlanListScreen

    Outcome:
        new MealPlan appears in list sorted by date
}
